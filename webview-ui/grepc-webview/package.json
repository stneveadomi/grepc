{
    "name": "grepc-webview",
    "type": "commonjs",
    "version": "1.3.1",
    "engines": {
        "node": ">=24"
    },
    "jest": {
        "preset": "jest-preset-angular",
        "setupFilesAfterEnv": [
            "<rootDir>/src/setup.jest.ts"
        ]
    },
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "build:production": "ng build --configuration production",
        "lint": "eslint",
        "prettier:check": "prettier . --check ",
        "prettier:write": "prettier . --write",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "clean": "rimraf dist"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^21.2.26",
        "@angular/common": "^21.2.26",
        "@angular/compiler": "^21.2.26",
        "@angular/core": "^21.2.26",
        "@angular/forms": "^21.2.26",
        "@angular/platform-browser": "^21.2.26",
        "@angular/platform-browser-dynamic": "^21.2.26",
        "@vscode/codicons": "^0.0.35",
        "html-entities": "^2.6.0",
        "ngx-color-picker": "^20.1.1",
        "rxjs": "~7.8.0",
        "tslib": "^2.8.1",
        "zone.js": "^0.16.3"
    },
    "devDependencies": {
        "@angular/build": "^21.2.29",
        "@angular/cli": "^21.2.29",
        "@angular/compiler-cli": "^21.2.26",
        "@eslint/js": "9.16",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.19.2",
        "angular-eslint": "^21.4.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^9.1.0",
        "globals": "^15.15.0",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "jest-preset-angular": "^17.0.3",
        "jsdom": "^26.1.0",
        "prettier": "3.3.2",
        "rimraf": "^5.0.10",
        "typescript": "~5.9.3",
        "typescript-eslint": "8.72"
    },
    "lint-staged": {
        "*.{ts,js}": "eslint --fix",
        "*.{json,html,ts,js,css,md}": "prettier --write"
    }
}
