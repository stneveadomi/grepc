{
    "name": "grepc-webview",
    "type": "commonjs",
    "version": "1.3.1",
    "engines": {
        "node": ">=24.15.0"
    },
    "jest": {
        "preset": "jest-preset-angular",
        "setupFilesAfterEnv": [
            "<rootDir>/src/setup.jest.ts"
        ]
    },
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "build:production": "ng build --configuration production",
        "lint": "eslint",
        "prettier:check": "prettier . --check ",
        "prettier:write": "prettier . --write",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "clean": "rimraf dist"
    },
    "private": true,
    "dependencies": {
        "@angular/common": "^22.2.4",
        "@angular/compiler": "^22.2.4",
        "@angular/core": "^22.2.4",
        "@angular/forms": "^22.2.4",
        "@angular/platform-browser": "^22.2.4",
        "@vscode/codicons": "^0.0.35",
        "html-entities": "^2.6.0",
        "ngx-color-picker": "^20.1.1",
        "rxjs": "~7.8.0",
        "tslib": "^2.8.1",
        "zone.js": "^0.16.3"
    },
    "devDependencies": {
        "@angular/build": "^22.2.6",
        "@angular/cli": "^22.2.6",
        "@angular/compiler-cli": "^22.2.4",
        "@eslint/js": "^10.0.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.19.2",
        "angular-eslint": "^22.6.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "jest-preset-angular": "^17.0.3",
        "jsdom": "^26.1.0",
        "prettier": "3.9.10",
        "rimraf": "^6.1.4",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,html,css,md}": "prettier --write"
    }
}
